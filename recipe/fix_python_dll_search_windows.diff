diff --git a/scripts/python/openbabel/__init__.py.in b/scripts/python/openbabel/__init__.py.in
--- a/scripts/python/openbabel/__init__.py.in
+++ b/scripts/python/openbabel/__init__.py.in
@@ -9,6 +9,14 @@
     dll_dir = os.path.join(base_dir, "bin")
     if os.path.isdir(dll_dir):
         os.add_dll_directory(dll_dir)
+    # conda layout: Open Babel's runtime DLLs (openbabel-3.dll, inchi.dll, and
+    # dependencies such as cairo/libxml2/zlib) are installed to
+    # %CONDA_PREFIX%\Library\bin, not <package>/bin. Add that directory so the
+    # _openbabel extension can resolve them on Python 3.8+ (which no longer
+    # searches PATH for extension-module dependencies).
+    conda_dll_dir = os.path.join(sys.prefix, "Library", "bin")
+    if os.path.isdir(conda_dll_dir):
+        os.add_dll_directory(conda_dll_dir)
 
 if "${BUILD_BY_PIP}" == "ON":
     os.environ["BABEL_LIBDIR"] = os.path.join(base_dir, "lib", "openbabel", __version__)
